{
  "Factory Singleton Pattern": {
    "prefix": "factorysingleton",
    "body": [
      "class ${1:ClassName} {",
      "  // Static map to store instances",
      "  static final Map<String, ${1:ClassName}> _sync = {};",
      "  ",
      "  // Private properties",
      "  late String _container;",
      "  final Map<String, dynamic> _data = {};",
      "  late Future<bool> initStorage;",
      "  ",
      "  // Factory constructor",
      "  factory ${1:ClassName}([String container = '${1:ClassName}']) {",
      "    if (_sync.containsKey(container)) {",
      "      return _sync[container]!;",
      "    } else {",
      "      final instance = ${1:ClassName}._internal(container);",
      "      _sync[container] = instance;",
      "      return instance;",
      "    }",
      "  }",
      "  ",
      "  // Private constructor",
      "  ${1:ClassName}._internal(String container) {",
      "    _container = container;",
      "    initStorage = Future<bool>(() async {",
      "      await _init();",
      "      return true;",
      "    });",
      "  }",
      "  ",
      "  // Initialize",
      "  Future<void> _init() async {",
      "    // Your initialization code here",
      "    await Future.delayed(Duration(milliseconds: 100));",
      "  }",
      "  ",
      "  // Methods",
      "  void write(String key, dynamic value) {",
      "    _data[key] = value;",
      "  }",
      "  ",
      "  T? read<T>(String key) {",
      "    return _data[key] as T?;",
      "  }",
      "  ",
      "  void remove(String key) {",
      "    _data.remove(key);",
      "  }",
      "  ",
      "  void erase() {",
      "    _data.clear();",
      "  }",
      "  ",
      "  bool hasData(String key) {",
      "    return _data.containsKey(key);",
      "  }",
      "}"
    ],
    "description": "Create Factory Singleton Pattern class like GetStorage"
  },
  
  "Simple Factory Pattern": {
    "prefix": "simplefactory",
    "body": [
      "class ${1:ClassName} {",
      "  static final Map<String, ${1:ClassName}> _instances = {};",
      "  late String name;",
      "  ",
      "  factory ${1:ClassName}(String name) {",
      "    if (_instances.containsKey(name)) {",
      "      return _instances[name]!;",
      "    } else {",
      "      final instance = ${1:ClassName}._internal(name);",
      "      _instances[name] = instance;",
      "      return instance;",
      "    }",
      "  }",
      "  ",
      "  ${1:ClassName}._internal(String name) {",
      "    this.name = name;",
      "  }",
      "}"
    ],
    "description": "Simple Factory Pattern"
  }
}
